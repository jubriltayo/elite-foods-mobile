# Base URL of the Elite Foods API. Never hard-code this in a screen.
# Defaults to https://elite-foods.vercel.app/api/v1 when unset.
EXPO_PUBLIC_API_URL=https://elite-foods.vercel.app/api/v1

# The Google web OAuth client id. This is a public identifier, not a secret: it
# ships inside the app bundle either way. It must be the same client id the web
# app uses, so the ID token's audience is one the API already accepts and no
# GOOGLE_EXTRA_CLIENT_IDS change is needed on the server.
#
# No client secret is ever needed or stored in this app.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com
